{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(defaults read:*)",
      "Bash(git:*)",
      "Bash(tree:*)",
      "Bash(bash:*)",
      "Bash(chmod:*)",
      "Bash(make:*)",
      "WebFetch(domain:*)",
      "Bash(brew:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(ruby:*)",
      "Bash(gem:*)",
      "Read(//Users/hemantv/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ~/.claude/hooks/load-memory.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ~/.claude/hooks/save-memory.ts",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true,
    "learning-output-style@claude-code-plugins": true,
    "example-skills@anthropic-agent-skills": true
  },
  "alwaysThinkingEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754136251859
  }
}
